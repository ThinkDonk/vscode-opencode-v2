{
  "name": "vscode-opencode-v2",
  "displayName": "OpenCode v2 TUI",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "ThinkDonk",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1F2023",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThinkDonk/vscode-opencode-v2.git"
  },
  "bugs": {
    "url": "https://github.com/ThinkDonk/vscode-opencode-v2/issues"
  },
  "homepage": "https://github.com/ThinkDonk/vscode-opencode-v2#readme",
  "keywords": [
    "opencode",
    "tui",
    "terminal",
    "ai",
    "agent",
    "v2"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "ocv2.openTerminal",
        "title": "%command.openTerminal%"
      },
      {
        "command": "ocv2.openNewTerminal",
        "title": "%command.openNewTerminal%",
        "icon": {
          "light": "images/icon-light.svg",
          "dark": "images/icon-dark.svg"
        }
      },
      {
        "command": "ocv2.addFilepathToTerminal",
        "title": "%command.addFilepathToTerminal%"
      },
      {
        "command": "ocv2.addFilesToTerminal",
        "title": "%command.addFilesToTerminal%"
      },
      {
        "command": "ocv2.sendDiagnostics",
        "title": "%command.sendDiagnostics%"
      },
      {
        "command": "ocv2.usePromptTemplate",
        "title": "%command.usePromptTemplate%"
      }
    ],
    "keybindings": [
      {
        "command": "ocv2.openTerminal",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "ocv2.openNewTerminal",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "ocv2.addFilepathToTerminal",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ocv2.sendDiagnostics",
          "group": "opencode",
          "when": "resourceScheme == file || resourceScheme == vscode-remote"
        },
        {
          "command": "ocv2.usePromptTemplate",
          "group": "opencode",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote)"
        }
      ],
      "explorer/context": [
        {
          "command": "ocv2.addFilesToTerminal",
          "group": "opencode",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "ocv2.openNewTerminal",
          "group": "navigation",
          "when": "editorFocus"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode v2 TUI",
      "properties": {
        "ocv2.binary": {
          "type": "string",
          "default": "opencode",
          "description": "%config.binary%"
        },
        "ocv2.terminalName": {
          "type": "string",
          "default": "opencode",
          "description": "%config.terminalName%"
        },
        "ocv2.injectOnLaunch": {
          "type": "boolean",
          "default": false,
          "description": "%config.injectOnLaunch%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/smoke.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
